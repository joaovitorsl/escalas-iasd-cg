rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthorized() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['joaovitorsilvaluciano@gmail.com'];
    }
    match /agenda_publica/atual {
      allow get: if true;
      allow create, update: if isAuthorized()
        && request.resource.data.keys().hasOnly(['versao', 'cultos', 'membros', 'gruposMusicais', 'temasCulto', 'tiposCulto', 'modelosPrograma', 'cultosRemovidos'])
        && request.resource.data.cultos is list
        && request.resource.data.membros is list;
      allow delete, list: if false;
    }
    match /iasd_cg/estado_global {
      allow read: if isAuthorized();
      allow create, update: if isAuthorized()
        && request.resource.data.membros is list
        && request.resource.data.cultos is list
        && request.resource.data.tiposCulto is list;
      allow delete: if false;
    }
  }
}
